# Public client-side environment variables (safe to expose in browser bundle)
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR_SUPABASE_PROJECT_ID"
# Optional: override backend origin for Capacitor mobile builds
# VITE_API_BASE_URL="https://chandanaish-darbar.com"

# Server-only secrets (set in Vercel Project Settings -> Environment Variables; NEVER prefix with VITE_)
GROQ_API_KEY="YOUR_GROQ_API_KEY"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_IDS"
SMS_API_KEY="YOUR_SMS_API_KEY"
